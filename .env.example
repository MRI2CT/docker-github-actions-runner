# Copy to .env before running docker compose.
# Use a repo-scoped label so proof workflows can target this runner without
# colliding with other MRI2CT self-hosted runners.
COMPOSE_CONTAINER_NAME=komodo-poc-runner
COMPOSE_IMAGE_NAME=komodo-github-actions-runner:local

RUNNER_SCOPE=repo
REPO_URL=https://github.com/MRI2CT/REPO_NAME

# Use either ACCESS_TOKEN or RUNNER_TOKEN. Leave the unused option blank.
ACCESS_TOKEN=
RUNNER_TOKEN=
APP_ID=
# GitHub App private keys must stay on one line in .env.
# Use literal \n escapes for newlines instead of pasting a raw PEM block.
APP_PRIVATE_KEY=
APP_LOGIN=

RUNNER_NAME=komodo-poc-runner
RUNNER_NAME_PREFIX=komodo-poc
RANDOM_RUNNER_SUFFIX=false
# This host path is bind-mounted at the same absolute path inside the container.
RUNNER_WORKDIR=/srv/github-runners/komodo-poc-runner
RUNNER_GROUP=Default
# Unique proof labels isolate runner selection only.
RUNNER_LABELS=self-hosted,linux,x64,repo-proof-REPO_NAME
LABELS=
GITHUB_HOST=github.com
RUN_AS_ROOT=true
DISABLE_AUTOMATIC_DEREGISTRATION=false
CONFIGURED_ACTIONS_RUNNER_FILES_DIR=
EPHEMERAL=
DISABLE_AUTO_UPDATE=
START_DOCKER_SERVICE=false
NO_DEFAULT_LABELS=
DEBUG_ONLY=false
DEBUG_OUTPUT=false
# Keep false so compose-managed shutdown can still deregister the runner.
# Set true only if you accept the workflow-env leakage tradeoff.
UNSET_CONFIG_VARS=false
