# Copy to .env before running docker compose.
# Use a repo-scoped label so proof workflows can target this runner without
# colliding with other MRI2CT self-hosted runners.
COMPOSE_IMAGE_NAME=komodo-github-actions-runner:local

RUNNER_SCOPE=repo
REPO_URL=https://github.com/MRI2CT/REPO_NAME

# Use either ACCESS_TOKEN or RUNNER_TOKEN. Leave the unused option blank.
ACCESS_TOKEN=
RUNNER_TOKEN=
APP_ID=
# GitHub App private keys must stay on one line in .env.
# Use literal \n escapes for newlines instead of pasting a raw PEM block.
APP_PRIVATE_KEY=
APP_LOGIN=

# Fleet size: number of runner replicas to run from this one Compose service.
# Scale up/down by changing this ONE value, then `docker compose up -d`.
RUNNER_REPLICAS=1

# Leave RUNNER_NAME blank whenever RUNNER_REPLICAS > 1: each replica then
# auto-generates its own unique name from RUNNER_NAME_PREFIX + a random
# suffix. Only set RUNNER_NAME to a fixed value when RUNNER_REPLICAS=1 and you
# want one specific, stable runner name.
RUNNER_NAME=
RUNNER_NAME_PREFIX=komodo-poc
RANDOM_RUNNER_SUFFIX=true

# Shared parent work directory for the WHOLE fleet (not one runner). This
# host path is bind-mounted at the same absolute path inside every replica;
# each replica creates and uses its own uniquely-named subdirectory under it
# (named after its own container hostname) so concurrent jobs never collide,
# with no per-replica configuration needed. Must already exist on the host.
RUNNER_WORKDIR=/srv/github-runners/komodo-poc-runner

RUNNER_GROUP=Default
# Unique proof labels isolate runner selection only; shared by every replica
# in the fleet (GitHub dispatches queued jobs to whichever replica is free).
RUNNER_LABELS=self-hosted,linux,x64,repo-proof-REPO_NAME
LABELS=
GITHUB_HOST=github.com
RUN_AS_ROOT=true
DISABLE_AUTOMATIC_DEREGISTRATION=false
CONFIGURED_ACTIONS_RUNNER_FILES_DIR=
EPHEMERAL=
DISABLE_AUTO_UPDATE=
START_DOCKER_SERVICE=false
NO_DEFAULT_LABELS=
DEBUG_ONLY=false
DEBUG_OUTPUT=false
# Keep false so compose-managed shutdown can still deregister the runners.
# Set true only if you accept the workflow-env leakage tradeoff.
UNSET_CONFIG_VARS=false

# Shared uv package-manager cache (host path), mounted read/write into every
# replica at a fixed container path so `uv` installs are warm across runs and
# across the whole fleet. Safe to share -- uv's cache supports concurrent
# access. Must already exist on the host.
UV_CACHE_DIR_HOST=/srv/github-runners/uv-cache
